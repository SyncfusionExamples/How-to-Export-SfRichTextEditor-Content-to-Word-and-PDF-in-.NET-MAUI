<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ExportRTEAsDocs"
             xmlns:editor="clr-namespace:Syncfusion.Maui.RichTextEditor;assembly=Syncfusion.Maui.RichTextEditor"
             x:Class="ExportRTEAsDocs.MainPage">

    <ContentPage.BindingContext>
        <local:ViewModel/>
    </ContentPage.BindingContext>

    <Grid RowDefinitions="9*,*" ColumnDefinitions="*,*" RowSpacing="5" ColumnSpacing="5" Padding="5">
        <editor:SfRichTextEditor Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="editor" HtmlText="{Binding HtmlText}"></editor:SfRichTextEditor>
        <Button Grid.Row="1" Grid.Column="0" Text="Export as PDF" CornerRadius="30" Clicked="ExportPdf_Click"/>
        <Button Grid.Row="1" Grid.Column="1" Text="Export as Doc" CornerRadius="30" Clicked="ExportDoc_Click"/>
    </Grid>

    

</ContentPage>
